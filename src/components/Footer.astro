---
import { siteInfo, navLinks, services } from '../data/siteContent';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-page-alt pt-14 pb-24 text-sm text-muted">
  <div class="mx-auto max-w-6xl px-4 sm:px-8">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-12">
      <!-- Marca -->
      <div class="lg:col-span-4">
        <a href="#inicio" class="inline-flex items-center gap-2.5 no-underline">
          <span
            class="grid size-9 place-items-center rounded-xl bg-accent font-serif text-[15px] font-bold text-on-accent"
          >
            {siteInfo.shortMark}
          </span>
          <span class="font-serif text-lg font-bold tracking-tight text-ink">
            Dev<span class="text-accent">Soluciones</span>
          </span>
        </a>
        <p class="mt-3 leading-relaxed text-muted">
          {siteInfo.tagline}
        </p>
        <p class="mt-3 text-xs text-muted">{siteInfo.location}</p>
        <div class="mt-5">
          <p class="mb-2.5 text-xs font-semibold tracking-wider text-ink uppercase">Redes sociales</p>
          <SocialLinks showLabels={true} />
        </div>
      </div>

      <!-- Servicios -->
      <div class="lg:col-span-5">
        <h3 class="font-serif text-base font-semibold text-ink">Servicios</h3>
        <ul class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
          {
            services.map((service) => (
              <li>
                <a
                  href="#servicios"
                  data-footer-service={service.title}
                  class="transition-colors hover:text-accent"
                >
                  {service.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Navegación y contacto -->
      <div class="lg:col-span-3">
        <h3 class="font-serif text-base font-semibold text-ink">Navegación</h3>
        <ul class="mt-3 space-y-2">
          {
            navLinks.map((item) => (
              <li>
                <a href={item.href} class="transition-colors hover:text-accent">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="mt-5 border-t border-line pt-4">
          <a href={`mailto:${siteInfo.email}`} class="font-medium text-accent hover:underline">
            {siteInfo.email}
          </a>
        </div>
      </div>
    </div>

    <div
      class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6 text-xs text-muted"
    >
      <p>© {year} {siteInfo.brand}. Todos los derechos reservados.</p>
      <p>Desarrollado con Astro y Tailwind CSS.</p>
    </div>
  </div>
</footer>
