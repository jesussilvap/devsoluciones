---
import { caseStudies } from '../data/siteContent';
---

<section id="proyectos" class="border-y border-line bg-page-alt py-16 lg:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-8">
    <div class="max-w-3xl">
      <span class="eyebrow mb-3">Resultados aplicables</span>
      <h2 class="section-heading text-3xl sm:text-4xl">Soluciones en acción</h2>
      <p class="mt-3 text-base text-muted sm:text-lg">
        Ejemplos de cómo combinamos ingeniería de software, e-commerce, marketing e IA para resolver retos concretos.
      </p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {
        caseStudies.map((item) => (
          <article class="card card-hover flex flex-col justify-between">
            <div>
              <span class="rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold text-accent-ink">
                {item.tag}
              </span>
              <h3 class="mt-4 font-serif text-xl font-bold text-ink">{item.title}</h3>

              <dl class="mt-4 space-y-3 text-sm">
                <div>
                  <dt class="font-semibold text-ink">Reto</dt>
                  <dd class="mt-0.5 text-muted">{item.challenge}</dd>
                </div>
                <div>
                  <dt class="font-semibold text-ink">Solución</dt>
                  <dd class="mt-0.5 text-muted">{item.solution}</dd>
                </div>
              </dl>
            </div>

            <div class="mt-5 rounded-xl border border-gold/35 bg-gold-soft/50 p-3.5 text-sm">
              <p class="text-xs font-semibold tracking-wider text-gold uppercase">Impacto esperado</p>
              <p class="mt-1 font-medium text-ink">{item.impact}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
