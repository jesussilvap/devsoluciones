---
import { serviceCategories, services } from '../data/siteContent';
---

<section id="servicios" class="py-16 lg:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-8">
    <div class="max-w-3xl">
      <span class="eyebrow mb-3">Catálogo integral</span>
      <h2 class="section-heading text-3xl sm:text-4xl">Nuestros servicios</h2>
      <p class="mt-3 text-base text-muted sm:text-lg">
        Desde ingeniería de software a la medida hasta presencia web, marketing digital,
        capacitaciones en IA y automatización de procesos. Selecciona una categoría o cotiza directamente.
      </p>
    </div>

    <!-- Filtros por categoría -->
    <div
      role="tablist"
      aria-label="Filtrar servicios por categoría"
      class="mt-8 flex flex-wrap gap-2"
    >
      {
        serviceCategories.map((cat, index) => (
          <button
            type="button"
            role="tab"
            data-filter-btn={cat.id}
            aria-selected={index === 0 ? 'true' : 'false'}
            class:list={[
              'cursor-pointer rounded-full border px-4 py-2 text-sm font-medium transition-all duration-150',
              index === 0
                ? 'border-accent bg-accent text-on-accent'
                : 'border-line bg-surface text-muted hover:border-accent hover:text-ink',
            ]}
          >
            {cat.label}
          </button>
        ))
      }
    </div>

    <!-- Grid de los 8 servicios -->
    <div id="servicesGrid" class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-2">
      {
        services.map((service) => (
          <article
            data-service-card
            data-category={service.category}
            class="card card-hover flex flex-col justify-between"
          >
            <div>
              <div class="flex items-start justify-between gap-3">
                <div class="grid size-11 shrink-0 place-items-center rounded-xl bg-accent-soft text-accent-ink">
                  {service.icon === 'code' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true" class="size-5.5 fill-none stroke-current stroke-[1.9]" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="16 18 22 12 16 6"></polyline>
                      <polyline points="8 6 2 12 8 18"></polyline>
                    </svg>
                  )}
                  {service.icon === 'smartphone' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true" class="size-5.5 fill-none stroke-current stroke-[1.9]" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect>
                      <path d="M12 18h.01"></path>
                    </svg>
                  )}
                  {service.icon === 'shopping-bag' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true" class="size-5.5 fill-none stroke-current stroke-[1.9]" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
                      <path d="M3 6h18"></path>
                      <path d="M16 10a4 4 0 0 1-8 0"></path>
                    </svg>
                  )}
                  {service.icon === 'globe' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true" class="size-5.5 fill-none stroke-current stroke-[1.9]" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
                      <path d="M2 12h20"></path>
                    </svg>
                  )}
                  {service.icon === 'rocket' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true" class="size-5.5 fill-none stroke-current stroke-[1.9]" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path>
                      <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path>
                      <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path>
                      <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path>
                    </svg>
                  )}
                  {service.icon === 'megaphone' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true" class="size-5.5 fill-none stroke-current stroke-[1.9]" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m3 11 18-5v12L3 14v-3z"></path>
                      <path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"></path>
                    </svg>
                  )}
                  {service.icon === 'sparkles' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true" class="size-5.5 fill-none stroke-current stroke-[1.9]" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"></path>
                    </svg>
                  )}
                  {service.icon === 'workflow' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true" class="size-5.5 fill-none stroke-current stroke-[1.9]" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="8" height="8" x="3" y="3" rx="2"></rect>
                      <path d="M7 11v4a2 2 0 0 0 2 2h4"></path>
                      <rect width="8" height="8" x="13" y="13" rx="2"></rect>
                    </svg>
                  )}
                </div>

                <div class="flex flex-wrap items-center justify-end gap-1.5">
                  <span class="rounded-full border border-line bg-page-alt px-2.5 py-0.5 text-xs font-medium text-muted">
                    {service.categoryLabel}
                  </span>
                  {service.badge && (
                    <span class="rounded-full bg-gold-soft px-2.5 py-0.5 text-xs font-semibold text-gold">
                      {service.badge}
                    </span>
                  )}
                </div>
              </div>

              <h3 class="mt-4 font-serif text-xl font-bold text-ink">{service.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{service.summary}</p>

              <ul class="mt-4 space-y-2 border-t border-line pt-4 text-sm text-ink/90">
                {service.deliverables.map((item) => (
                  <li class="flex items-start gap-2">
                    <svg
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      class="mt-0.5 size-4 shrink-0 fill-none stroke-accent stroke-[2.3]"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M20 6 9 17l-5-5"></path>
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-6 pt-2">
              <button
                type="button"
                data-select-service={service.title}
                class="inline-flex cursor-pointer items-center gap-1.5 text-sm font-semibold text-accent transition-colors hover:text-accent-ink"
              >
                Cotizar este servicio
                <span aria-hidden="true">→</span>
              </button>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter-btn]'));
  const serviceCards = Array.from(document.querySelectorAll<HTMLElement>('[data-service-card]'));

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.dataset.filterBtn ?? 'all';

      filterBtns.forEach((item) => {
        const active = item === btn;
        item.setAttribute('aria-selected', String(active));
        item.classList.toggle('border-accent', active);
        item.classList.toggle('bg-accent', active);
        item.classList.toggle('text-on-accent', active);
        item.classList.toggle('border-line', !active);
        item.classList.toggle('bg-surface', !active);
        item.classList.toggle('text-muted', !active);
      });

      serviceCards.forEach((card) => {
        const match = selected === 'all' || card.dataset.category === selected;
        card.classList.toggle('hidden', !match);
      });
    });
  });

  // Pre-selecciona el servicio en el formulario de contacto y hace scroll suave
  document.addEventListener('click', (event) => {
    const target = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-select-service]');
    if (!target) return;

    const serviceName = target.dataset.selectService;
    if (!serviceName) return;

    window.dispatchEvent(new CustomEvent('devsoluciones:select-service', { detail: serviceName }));
    document.getElementById('contacto')?.scrollIntoView({ behavior: 'smooth' });
  });
</script>
