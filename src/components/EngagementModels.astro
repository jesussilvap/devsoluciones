---
import { engagementModels } from '../data/siteContent';
---

<section id="modalidades" class="py-16 lg:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-8">
    <div class="max-w-3xl">
      <span class="eyebrow mb-3">Flexibilidad comercial</span>
      <h2 class="section-heading text-3xl sm:text-4xl">Modalidades de trabajo</h2>
      <p class="mt-3 text-base text-muted sm:text-lg">
        Elige el formato que mejor se ajuste a la etapa actual de tu emprendimiento o empresa.
      </p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {
        engagementModels.map((model) => (
          <article
            class:list={[
              'card flex flex-col justify-between',
              model.highlighted && 'border-accent ring-1 ring-accent/35 shadow-lg shadow-accent/5',
            ]}
          >
            <div>
              {model.highlighted && (
                <span class="eyebrow-gold mb-3">Más solicitado</span>
              )}
              <h3 class="font-serif text-xl font-bold text-ink">{model.name}</h3>
              <p class="mt-1.5 text-sm text-muted">{model.subtitle}</p>

              <p class="mt-4 rounded-lg bg-page-alt px-3 py-2 text-xs font-medium text-ink">
                <span class="text-muted">Ideal para:</span> {model.idealFor}
              </p>

              <ul class="mt-5 space-y-2.5 text-sm text-ink/90">
                {model.features.map((feat) => (
                  <li class="flex items-start gap-2">
                    <svg
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      class="mt-0.5 size-4 shrink-0 fill-none stroke-accent stroke-[2.3]"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M20 6 9 17l-5-5"></path>
                    </svg>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-6 pt-2">
              <button
                type="button"
                data-select-service={model.presetService}
                class:list={[
                  'w-full',
                  model.highlighted ? 'btn-primary' : 'btn-secondary',
                ]}
              >
                {model.ctaText}
              </button>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
