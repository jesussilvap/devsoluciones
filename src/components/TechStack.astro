---
import { techStackGroups } from '../data/siteContent';
---

<section aria-label="Tecnologías que utilizamos" class="border-b border-line bg-page-alt py-8">
  <div class="mx-auto max-w-6xl px-4 sm:px-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <p class="shrink-0 text-xs font-semibold tracking-wider text-muted uppercase">
        Tecnologías &amp; plataformas
      </p>
      <ul class="flex flex-wrap gap-2">
        {
          techStackGroups.map((tech) => (
            <li class="rounded-full bg-accent-soft px-3 py-1 text-xs font-medium text-accent-ink sm:text-[13px]">
              {tech}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
