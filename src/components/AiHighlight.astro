---
import { aiHighlights } from '../data/siteContent';
---

<section id="ia-automatizacion" class="border-y border-line bg-page-alt py-16 lg:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5">
        <span class="eyebrow-gold mb-3">Diferenciador estratégico</span>
        <h2 class="font-serif text-3xl font-bold tracking-tight text-ink sm:text-4xl">
          Inteligencia Artificial aplicada y automatizaciones reales
        </h2>
        <p class="mt-4 text-base leading-relaxed text-muted">
          No vendemos teoría: diseñamos <strong>flujos automatizados</strong> que ahorran horas desde la
          primera semana y brindamos <strong>asesorías y capacitaciones prácticas en IA</strong> para que
          tu equipo trabaje con mayor velocidad, precisión y criterio.
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          <button
            type="button"
            data-select-service="Asesorías y capacitaciones en IA"
            class="btn-primary"
          >
            Solicitar capacitación en IA
          </button>
          <button
            type="button"
            data-select-service="Automatizaciones de procesos"
            class="btn-secondary"
          >
            Automatizar un proceso
          </button>
        </div>
      </div>

      <div class="grid gap-4 lg:col-span-7">
        {
          aiHighlights.map((item, idx) => (
            <div class="card card-hover flex items-start gap-4">
              <div class="grid size-10 shrink-0 place-items-center rounded-xl bg-gold-soft font-mono text-sm font-bold text-gold">
                0{idx + 1}
              </div>
              <div>
                <p class="text-xs font-semibold tracking-wider text-gold uppercase">{item.label}</p>
                <h3 class="mt-1 font-serif text-lg font-bold text-ink">{item.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-muted">{item.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
