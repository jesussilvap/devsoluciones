---
import { siteInfo, getWhatsAppUrl } from '../data/siteContent';

interface Props {
  showLabels?: boolean;
  class?: string;
}

const { showLabels = false, class: className = '' } = Astro.props;

const items = [
  {
    name: 'Facebook',
    href: siteInfo.social.facebook,
    label: `Seguir a ${siteInfo.brand} en Facebook`,
    type: 'facebook',
  },
  {
    name: 'Instagram',
    href: siteInfo.social.instagram,
    label: `Seguir a ${siteInfo.brand} en Instagram`,
    type: 'instagram',
  },
  {
    name: 'WhatsApp',
    href: getWhatsAppUrl(),
    label: `Escribir a ${siteInfo.brand} por WhatsApp`,
    type: 'whatsapp',
  },
] as const;
---

<div class:list={['flex flex-wrap items-center gap-2.5', className]}>
  {
    items.map((item) => (
      <a
        href={item.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={item.label}
        title={item.name}
        class:list={[
          'inline-flex items-center justify-center gap-2 rounded-xl border border-line bg-surface text-ink transition-all duration-150 hover:border-accent hover:bg-accent-soft hover:text-accent-ink',
          showLabels ? 'px-3.5 py-2 text-sm font-medium' : 'size-10',
        ]}
      >
        {item.type === 'facebook' && (
          <svg viewBox="0 0 24 24" aria-hidden="true" class="size-4.5 fill-current">
            <path d="M13.5 21v-8.2h2.7l.4-3.2h-3.1V7.5c0-.9.3-1.6 1.6-1.6h1.7V3.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.4H7.5v3.2h2.7V21h3.3z" />
          </svg>
        )}
        {item.type === 'instagram' && (
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            class="size-4.5 fill-none stroke-current stroke-[1.9]"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect width="18" height="18" x="3" y="3" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none" />
          </svg>
        )}
        {item.type === 'whatsapp' && (
          <svg viewBox="0 0 24 24" aria-hidden="true" class="size-4.5 fill-current">
            <path d="M20.52 3.48A11.82 11.82 0 0 0 12.05 0C5.49 0 .16 5.33.16 11.89c0 2.1.55 4.15 1.59 5.95L0 24l6.33-1.66a11.86 11.86 0 0 0 5.72 1.46h.01c6.55 0 11.89-5.34 11.89-11.9 0-3.18-1.24-6.16-3.43-8.42zM12.06 21.8h-.01a9.86 9.86 0 0 1-5.03-1.38l-.36-.21-3.76.99 1-3.66-.24-.38a9.83 9.83 0 0 1-1.51-5.27c0-5.45 4.44-9.89 9.9-9.89 2.64 0 5.13 1.03 7 2.9a9.84 9.84 0 0 1 2.89 7c0 5.46-4.44 9.9-9.88 9.9zm5.42-7.41c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.21 5.09 4.5.71.31 1.27.49 1.7.63.72.23 1.37.2 1.88.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35z" />
          </svg>
        )}
        {showLabels && <span>{item.name}</span>}
      </a>
    ))
  }
</div>
