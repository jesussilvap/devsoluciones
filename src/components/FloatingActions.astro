---
import { getWhatsAppUrl, siteInfo } from '../data/siteContent';
---

<div
  class="fixed right-4 bottom-4 z-40 flex flex-col items-end gap-3 sm:right-6 sm:bottom-6 print:hidden"
  aria-label="Acciones rápidas"
>
  <!-- Botón de subir al inicio (aparece al salir del Hero) -->
  <button
    id="backToTop"
    type="button"
    aria-label="Subir al inicio"
    title="Subir al inicio"
    data-visible="false"
    class="pointer-events-none grid size-12 translate-y-4 cursor-pointer place-items-center rounded-full bg-accent text-on-accent opacity-0 shadow-lg ring-1 ring-black/10 transition-all duration-300 hover:bg-accent-ink focus-visible:outline-offset-4 data-[visible=true]:pointer-events-auto data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100"
  >
    <svg
      viewBox="0 0 24 24"
      aria-hidden="true"
      class="size-5 fill-none stroke-current stroke-[2.2]"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M12 19V5m0 0-6 6m6-6 6 6"></path>
    </svg>
  </button>

  <!-- Botón flotante directo a WhatsApp -->
  <a
    href={getWhatsAppUrl()}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Escribir a ${siteInfo.brand} por WhatsApp`}
    title="Chatear por WhatsApp"
    class="grid size-12 place-items-center rounded-full bg-[#25D366] text-white shadow-lg ring-1 ring-black/10 transition-transform duration-200 hover:scale-105 hover:bg-[#1ebe5d]"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" class="size-6 fill-current">
      <path d="M20.52 3.48A11.82 11.82 0 0 0 12.05 0C5.49 0 .16 5.33.16 11.89c0 2.1.55 4.15 1.59 5.95L0 24l6.33-1.66a11.86 11.86 0 0 0 5.72 1.46h.01c6.55 0 11.89-5.34 11.89-11.9 0-3.18-1.24-6.16-3.43-8.42zM12.06 21.8h-.01a9.86 9.86 0 0 1-5.03-1.38l-.36-.21-3.76.99 1-3.66-.24-.38a9.83 9.83 0 0 1-1.51-5.27c0-5.45 4.44-9.89 9.9-9.89 2.64 0 5.13 1.03 7 2.9a9.84 9.84 0 0 1 2.89 7c0 5.46-4.44 9.9-9.88 9.9zm5.42-7.41c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.21 5.09 4.5.71.31 1.27.49 1.7.63.72.23 1.37.2 1.88.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35z"></path>
    </svg>
  </a>
</div>

<script>
  const backToTopBtn = document.getElementById('backToTop');
  const heroSection = document.getElementById('inicio');

  if (backToTopBtn && heroSection) {
    new IntersectionObserver(([entry]) => {
      backToTopBtn.dataset.visible = String(!entry.isIntersecting);
    }).observe(heroSection);

    backToTopBtn.addEventListener('click', () => {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reducedMotion ? 'auto' : 'smooth' });
      const firstHeaderLink = document.querySelector<HTMLElement>('header a');
      firstHeaderLink?.focus({ preventScroll: true });
    });
  }
</script>
