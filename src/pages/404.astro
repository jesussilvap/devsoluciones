---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteInfo } from '../data/siteContent';
---

<BaseLayout title={`Página no encontrada · ${siteInfo.brand}`}>
  <Header />
  <main id="contenido" class="hero-grid flex min-h-[65vh] items-center justify-center px-4 py-20 sm:px-8">
    <div class="card max-w-lg text-center">
      <span class="eyebrow-gold">Error 404</span>
      <h1 class="mt-4 font-serif text-3xl font-bold text-ink sm:text-4xl">
        No encontramos esta página
      </h1>
      <p class="mt-3 text-sm leading-relaxed text-muted sm:text-base">
        El enlace que buscas puede haber cambiado o ya no existe. Regresa al inicio para explorar los servicios de{' '}
        <strong>{siteInfo.brand}</strong>.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-primary">Volver al inicio</a>
        <a href="/#contacto" class="btn-secondary">Ir a contacto</a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
