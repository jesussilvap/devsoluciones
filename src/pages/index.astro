---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TechStack from '../components/TechStack.astro';
import ServicesSection from '../components/ServicesSection.astro';
import AiHighlight from '../components/AiHighlight.astro';
import ProcessSection from '../components/ProcessSection.astro';
import PortfolioSection from '../components/PortfolioSection.astro';
import EngagementModels from '../components/EngagementModels.astro';
import FaqSection from '../components/FaqSection.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
---

<BaseLayout>
  <Header />
  <main id="contenido">
    <Hero />
    <TechStack />
    <ServicesSection />
    <AiHighlight />
    <ProcessSection />
    <PortfolioSection />
    <EngagementModels />
    <FaqSection />
    <ContactSection />
  </main>
  <Footer />
  <FloatingActions />
</BaseLayout>
